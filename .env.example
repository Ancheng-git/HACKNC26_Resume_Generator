# Copy to .env in the project root. Never put this key in frontend code.
JSEARCH_API_KEY=
# Local upstream-attempt cap over rolling 31 days (failures count too).
JSEARCH_REQUEST_LIMIT=180
# Upstream socket timeout in seconds (1–60); no automatic retries.
JSEARCH_TIMEOUT_SECONDS=20
RESUME_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
