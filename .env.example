# Copy to .env in the project root. Never put this key in frontend code.
JSEARCH_API_KEY=
# Local upstream-attempt cap over rolling 31 days (failures count too).
JSEARCH_REQUEST_LIMIT=180
# Upstream socket timeout in seconds (1–60); no automatic retries.
JSEARCH_TIMEOUT_SECONDS=20
RESUME_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosted mode (all optional locally). Never commit real values.
# Tiger Cloud Postgres connection string; enables accounts, saved resumes and the daily limit.
DATABASE_URL=
# Anthropic API key for Claude Code on a server (a personal claude.ai login is for local use only).
ANTHROPIC_API_KEY=
# Generations per account per rolling 24 hours, and max running+queued tasks.
RESUME_DAILY_LIMIT=3
RESUME_QUEUE_LIMIT=10
# Host names the server answers to, e.g. minejob.example.com
RESUME_ALLOWED_HOSTS=localhost,127.0.0.1
